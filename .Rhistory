0.1, 0, 0.4, 0.2, 0,
0.2, 0.1, 0, 0.3, 0.1,
0, 0.2, 0.3, 0, 0.4,
0.1, 0, 0.2, 0.3, 0
), nrow = 5, byrow = TRUE)
g <- graph_from_adjacency_matrix(W, mode = "directed", weighted = TRUE)
simulate_system <- function(T = 80, dt = 0.1) {
n <- 5
X <- matrix(runif(n, 0.5, 1.5), nrow = T, ncol = n)
for (t in 2:T) {
x_prev <- X[t-1, ]
interaction <- W %*% x_prev
dX <- 0.6 * x_prev * (1 - x_prev) + 0.4 * interaction
X[t, ] <- x_prev + dt * dX
}
return(X)
}
X <- simulate_system()
dt <- 0.1
df_list <- list()
L <- diag(rowSums(W)) - W
for (t in 2:nrow(X)) {
x_prev <- X[t-1, ]
x_curr <- X[t, ]
dx <- (x_curr - x_prev) / dt
Wx <- W %*% x_prev
Lx <- L %*% x_prev
for (i in 1:5) {
df_list[[length(df_list)+1]] <- data.frame(
dx = dx[i], x = x_prev[i], Wx = Wx[i], Lx = Lx[i],
x2 = x_prev[i]^2, Wx2 = Wx[i]^2,
xWx = x_prev[i] * Wx[i], x1mx = x_prev[i] * (1 - x_prev[i])
)
}
}
df <- bind_rows(df_list)
result <- symbolic_search(
target = df$dx,
predictors = df[, c("x", "Wx", "Lx", "x2", "Wx2", "xWx", "x1mx")],
backend = "julia",
verbose = TRUE
)
head(result$pareto_front)
best_model <- select_equation(result)
gc()
Sys.setenv(JULIA_NUM_THREADS = "15")
library(igraph)
