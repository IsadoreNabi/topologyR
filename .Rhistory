W <- matrix(c(
0, 0.3, 0.2, 0,   0,
0.1, 0, 0.4, 0.2, 0,
0.2, 0.1, 0, 0.3, 0.1,
0, 0.2, 0.3, 0, 0.4,
0.1, 0, 0.2, 0.3, 0
), nrow = 5, byrow = TRUE)
g <- graph_from_adjacency_matrix(W, mode = "directed", weighted = TRUE)
simulate_system <- function(T = 80, dt = 0.1) {
n <- 5
X <- matrix(runif(n, 0.5, 1.5), nrow = T, ncol = n)
for (t in 2:T) {
x_prev <- X[t-1, ]
interaction <- W %*% x_prev
dX <- 0.6 * x_prev * (1 - x_prev) + 0.4 * interaction
X[t, ] <- x_prev + dt * dX
}
return(X)
}
X <- simulate_system()
dt <- 0.1
df_list <- list()
L <- diag(rowSums(W)) - W
for (t in 2:nrow(X)) {
x_prev <- X[t-1, ]
x_curr <- X[t, ]
dx <- (x_curr - x_prev) / dt
Wx <- W %*% x_prev
Lx <- L %*% x_prev
for (i in 1:5) {
df_list[[length(df_list)+1]] <- data.frame(
dx = dx[i], x = x_prev[i], Wx = Wx[i], Lx = Lx[i],
x2 = x_prev[i]^2, Wx2 = Wx[i]^2,
xWx = x_prev[i] * Wx[i], x1mx = x_prev[i] * (1 - x_prev[i])
)
}
}
df <- bind_rows(df_list)
result <- symbolic_search(
target = df$dx,
predictors = df[, c("x", "Wx", "Lx", "x2", "Wx2", "xWx", "x1mx")],
backend = "julia",
verbose = TRUE
)
head(result$pareto_front)
best_model <- select_equation(result)
best_model
pred <- predict(model, df)
pred <- predict(bestmodel, df)
pred <- predict(best_model, df)
plot(df$dx, pred, main = "Predicción vs Real")
abline(0,1,col="red")
eig <- eigen(L)
U <- eig$vectors
# Proyección en modos principales
proj <- as.matrix(X) %*% U[,1:2]
eig
U
proj
# 1. Definir el parámetro k (puedes cambiar este valor)
k <- 0.1
# 2. Construir la variable x entre 0 y 100 (usamos 1000 puntos para que la curva sea suave)
x <- seq(0, 100, length.out = 1000)
# 3. Aplicar la función
y <- (1 / k^2) * (sin(k * x - 2 * pi) + 1)
# 4. Graficar (usando R base para que no necesites instalar paquetes extra)
plot(x, y, type = "l", col = "blue", lwd = 2,
main = "Gráfico de y = (1/k^2) * [sin(kx - 2π) + 1]",
xlab = "x", ylab = "y")
# 2. Aplicar la función y = x^2
y <- x^2
# 3. Graficar usando R base
plot(x, y, type = "l", col = "red", lwd = 2,
main = expression("Gráfico de " * y == x^2),
xlab = "x", ylab = "y")
# 1. Parámetro de ensanchamiento
k <- 0.1
# 2. Variable x con valores negativos y positivos para ver la "U"
# Usamos de -25 a 25 para ver dónde coinciden y dónde empiezan a separarse
x <- seq(-25, 25, length.out = 1000)
# 3. Fórmulas (ambas corregidas)
y_parabola <- x^2
y_seno <- (2 / k^2) * (sin(k * x - pi / 2) + 1)
# 4. Graficar la parábola original (línea roja gruesa)
plot(x, y_parabola, type = "l", col = "red", lwd = 4,
main = "Equivalencia entre x^2 y función seno",
xlab = "x", ylab = "y")
# 5. Superponer la función seno (línea azul punteada)
lines(x, y_seno, col = "blue", lwd = 2, lty = 2)
# 6. Agregar leyenda
legend("top",
legend = c(expression(y == x^2), expression(y == frac(2, k^2)*(sin(k*x - pi/2) + 1))),
col = c("red", "blue"), lty = c(1, 2), lwd = c(4, 2))
###############################################################################
#
#  topologyR — full demonstration script
#
#  Variable: GDP_change (quarterly real GDP growth rate)
#
#  This script exercises every exported function in the package, verifying
#  correctness at each step.  "Maximum rigor" means:
#    - every function call checks its return structure,
#    - every topological object is validated against the axioms,
#    - the two graph-construction methods (HVG, NVG) are compared,
#    - the exact connectivity definition is contrasted with the three
#      legacy heuristics,
#    - threshold-based (metric approximation) functions are run and
#      explicitly distinguished from the Nada et al. graph-based path.
#
###############################################################################
Sys.setenv(OMP_NUM_THREADS = "15")
library(readxl)
library(topologyR)
# ── 0. Data ─────────────────────────────────────────────────────────────────
DATOS <- read_excel("E:/Carpeta de Estudio/[Teoría Marxista]/6. [Mis Investigaciones]/TEORÍA GENERAL SOBRE LOS CICLOS DE LA DINÁMICA DEL SISTEMA CAPITALISTA A LARGO PLAZO/DATOS YEO-JOHNSON MODELO FINAL.xlsx")
GDP_change <- as.numeric(DATOS$Real.GDP.Change)
n <- length(GDP_change)
stopifnot(is.numeric(GDP_change), !anyNA(GDP_change), all(is.finite(GDP_change)))
cat("n =", n, "observations\n\n")
###############################################################################
# PART I — GRAPH-THEORETIC PATH (Nada et al., faithful implementation)
###############################################################################
# ── 1. Horizontal Visibility Graph (HVG) ───────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("1. Horizontal Visibility Graph (HVG)\n")
cat("═══════════════════════════════════════════════════════════════════\n")
hvg <- horizontal_visibility_graph(GDP_change)
stopifnot(
is.list(hvg),
is.data.frame(hvg$edges),
identical(names(hvg$edges), c("from", "to")),
is.integer(hvg$n),
hvg$n == n,
is.integer(hvg$n_edges),
hvg$n_edges >= n - 1L,
is.list(hvg$adjacency),
length(hvg$adjacency) == n
)
# Verify symmetry: if j in N(i), then i in N(j)
for (i in seq_len(n)) {
for (j in hvg$adjacency[[i]]) {
stopifnot(i %in% hvg$adjacency[[j]])
}
}
# Verify all adjacent pairs are connected (HVG invariant)
for (i in seq_len(n - 1L)) {
stopifnot((i + 1L) %in% hvg$adjacency[[i]])
}
cat("  Edges:    ", hvg$n_edges, "\n")
cat("  Density:  ", round(hvg$n_edges / (n * (n - 1) / 2), 4), "\n")
cat("  Degree sequence (first 20):", head(vapply(hvg$adjacency, length, integer(1)), 20), "\n\n")
# ── 2. Natural Visibility Graph (NVG) ──────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("2. Natural Visibility Graph (NVG)\n")
cat("═══════════════════════════════════════════════════════════════════\n")
nvg <- natural_visibility_graph(GDP_change)
stopifnot(
is.list(nvg),
nvg$n == n,
nvg$n_edges >= hvg$n_edges
)
# Verify symmetry
for (i in seq_len(n)) {
for (j in nvg$adjacency[[i]]) {
stopifnot(i %in% nvg$adjacency[[j]])
}
}
# Verify NVG >= HVG: every HVG edge must also be an NVG edge
for (k in seq_len(nrow(hvg$edges))) {
a <- hvg$edges$from[k]
b <- hvg$edges$to[k]
stopifnot(b %in% nvg$adjacency[[a]])
}
cat("  Edges:    ", nvg$n_edges, "\n")
cat("  Density:  ", round(nvg$n_edges / (n * (n - 1) / 2), 4), "\n")
cat("  Extra edges over HVG:", nvg$n_edges - hvg$n_edges, "\n\n")
# ── 3. Topology from HVG ───────────────────────────────────────────────────
#
# Nada et al. procedure: neighborhoods -> subbase -> base (intersections) ->
# connectivity via specialization preorder (exact, polynomial, no enumeration
# needed). Topology enumeration is attempted with a safety limit.
cat("═══════════════════════════════════════════════════════════════════\n")
cat("3. Topology induced by HVG\n")
cat("═══════════════════════════════════════════════════════════════════\n")
topo_hvg <- generate_topology(
adjacency       = hvg$adjacency,
n_elements      = hvg$n,
max_open_sets   = 1000000L,
check_connected = TRUE,
verify_axioms   = TRUE
)
stopifnot(
is.list(topo_hvg),
is.logical(topo_hvg$connected),
is.list(topo_hvg$subbase),
is.list(topo_hvg$base),
is.list(topo_hvg$components),
length(topo_hvg$components) >= 1L
)
# If enumeration completed AND axioms were checked, verify
if (isTRUE(topo_hvg$complete) && !is.null(topo_hvg$axioms_ok)) {
stopifnot(topo_hvg$axioms_ok)
# Verify axiom 1 explicitly
sets <- topo_hvg$topology
has_empty <- any(vapply(sets, function(s) length(s) == 0L, logical(1)))
has_full  <- any(vapply(sets, function(s) setequal(s, seq_len(n)), logical(1)))
stopifnot(has_empty, has_full)
}
cat("  Subbase sets:   ", length(topo_hvg$subbase), "\n")
cat("  Base sets:      ", length(topo_hvg$base), "\n")
cat("  Connected:      ", topo_hvg$connected, "\n")
cat("  Components:     ", length(topo_hvg$components), "\n")
if (length(topo_hvg$components) <= 10) {
for (ci in seq_along(topo_hvg$components)) {
cat("    C", ci, "(", length(topo_hvg$components[[ci]]), "elements):",
head(topo_hvg$components[[ci]], 10), "\n")
}
}
cat("  Enumeration:    ", if (isTRUE(topo_hvg$complete))
paste("complete,", topo_hvg$n_open_sets, "open sets")
else "exceeded max_open_sets (base-only mode)", "\n")
cat("  Base iterations:", topo_hvg$iterations_base, "\n")
if (isTRUE(topo_hvg$complete) && !is.null(topo_hvg$axioms_ok)) {
cat("  Axioms OK:     ", topo_hvg$axioms_ok, "\n")
}
cat("\n")
# ── 4. Topology from NVG ───────────────────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("4. Topology induced by NVG\n")
cat("═══════════════════════════════════════════════════════════════════\n")
topo_nvg <- generate_topology(
adjacency       = nvg$adjacency,
n_elements      = nvg$n,
max_open_sets   = 1000000L,
check_connected = TRUE,
verify_axioms   = TRUE
)
stopifnot(is.logical(topo_nvg$connected))
cat("  Base sets:      ", length(topo_nvg$base), "\n")
cat("  Connected:      ", topo_nvg$connected, "\n")
cat("  Components:     ", length(topo_nvg$components), "\n")
cat("  Enumeration:    ", if (isTRUE(topo_nvg$complete))
paste("complete,", topo_nvg$n_open_sets, "open sets")
else "exceeded max_open_sets (base-only mode)", "\n\n")
# ── 5. Standalone exact connectivity check ─────────────────────────────────
#
# Only possible if the topology was fully enumerated.
# Otherwise the preorder-based check (in generate_topology) is the authority.
cat("═══════════════════════════════════════════════════════════════════\n")
cat("5. Standalone exact connectivity check\n")
cat("═══════════════════════════════════════════════════════════════════\n")
if (isTRUE(topo_hvg$complete)) {
conn_hvg <- is_topology_connected_exact(topo_hvg$topology, n)
cat("  HVG (complement check):", conn_hvg$connected, "\n")
# Must agree with preorder result
stopifnot(conn_hvg$connected == topo_hvg$connected)
} else {
cat("  HVG: topology not fully enumerated, using preorder result:",
topo_hvg$connected, "\n")
}
if (isTRUE(topo_nvg$complete)) {
conn_nvg <- is_topology_connected_exact(topo_nvg$topology, n)
cat("  NVG (complement check):", conn_nvg$connected, "\n")
stopifnot(conn_nvg$connected == topo_nvg$connected)
} else {
cat("  NVG: topology not fully enumerated, using preorder result:",
topo_nvg$connected, "\n")
}
cat("\n")
# ── 6. Legacy connectivity heuristics (for comparison) ─────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("6. Legacy connectivity heuristics vs. exact definition\n")
cat("═══════════════════════════════════════════════════════════════════\n")
if (isTRUE(topo_hvg$complete)) {
legacy1 <- is_topology_connected(topo_hvg$topology)
legacy2 <- is_topology_connected2(topo_hvg$topology)
legacy3 <- is_topology_connected_manual(topo_hvg$topology)
exact   <- topo_hvg$connected
cat("  is_topology_connected (undirected DFS): ", legacy1, "\n")
cat("  is_topology_connected2 (directed DFS):  ", legacy2, "\n")
cat("  is_topology_connected_manual (coverage): ", legacy3, "\n")
cat("  Exact (preorder/complement):             ", exact, "\n")
if (exact) stopifnot(legacy3)
} else {
cat("  (Legacy checks require fully enumerated topology; skipped)\n")
cat("  Exact connectivity (preorder): ", topo_hvg$connected, "\n")
}
cat("\n")
###############################################################################
# PART II — THRESHOLD-BASED PATH (metric approximation)
###############################################################################
cat("═══════════════════════════════════════════════════════════════════\n")
cat("7. Threshold calculation methods\n")
cat("═══════════════════════════════════════════════════════════════════\n")
thresholds <- calculate_thresholds(GDP_change)
stopifnot(
is.list(thresholds),
identical(names(thresholds), c("mean_diff", "median_diff", "sd", "iqr", "dbscan")),
all(vapply(thresholds, is.numeric, logical(1))),
all(vapply(thresholds, function(x) length(x) == 1L && x > 0, logical(1)))
)
cat("  mean_diff:  ", round(thresholds$mean_diff, 4), "\n")
cat("  median_diff:", round(thresholds$median_diff, 4), "\n")
cat("  sd:         ", round(thresholds$sd, 4), "\n")
cat("  iqr:        ", round(thresholds$iqr, 4), "\n")
cat("  dbscan:     ", round(thresholds$dbscan, 4), "\n\n")
# ── 8. Base size for each threshold ─────────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("8. Base size by threshold method\n")
cat("═══════════════════════════════════════════════════════════════════\n")
for (nm in names(thresholds)) {
bs <- calculate_topology(GDP_change, threshold = thresholds[[nm]])
stopifnot(is.numeric(bs), bs >= 2L)
cat(sprintf("  %-12s  threshold = %6.4f  ->  base size = %d\n",
nm, thresholds[[nm]], bs))
}
cat("\n")
# ── 9. Visualize threshold comparisons ─────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("9. Threshold visualization\n")
cat("═══════════════════════════════════════════════════════════════════\n")
viz <- visualize_topology_thresholds(GDP_change, plot = TRUE)
stopifnot(
is.data.frame(viz),
all(c("method", "threshold", "base_size") %in% names(viz)),
nrow(viz) == 5L
)
plots <- attr(viz, "plots")
stopifnot(is.list(plots), length(plots) == 3L)
cat("  Methods tested:", nrow(viz), "\n")
cat("  Plots generated: 3 (threshold, base_size, scatter)\n\n")
# ── 10. Analyze IQR factor sensitivity ─────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("10. IQR factor analysis\n")
cat("═══════════════════════════════════════════════════════════════════\n")
factors <- c(1, 2, 4, 8, 16, 32)
af <- analyze_topology_factors(GDP_change, factors = factors, plot = TRUE)
stopifnot(
is.data.frame(af),
nrow(af) == length(factors),
all(c("factor", "threshold", "base_size", "max_set_size", "min_set_size")
%in% names(af)),
!is.null(attr(af, "plot"))
)
cat("  Factors tested:", nrow(af), "\n")
print(af)
cat("\n")
###############################################################################
# PART III — DEGENERATE CASES
###############################################################################
# ── 11. Discrete topology (simplest_topology) ──────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("11. Discrete topology (simplest_topology)\n")
cat("═══════════════════════════════════════════════════════════════════\n")
st <- simplest_topology(GDP_change)
stopifnot(
is.list(st),
st$topology_type == "discrete",
st$n == n,
length(st$base) == n,
!st$connected
)
for (i in seq_len(n)) {
stopifnot(length(st$base[[i]]) == 1L)
}
cat("  Type:       ", st$topology_type, "\n")
cat("  n:          ", st$n, "\n")
cat("  Connected:  ", st$connected, "\n")
cat("  Base:        singletons {{1}, {2}, ..., {n}}\n\n")
# ── 12. Complete-graph topology ─────────────────────────────────────────────
cat("═══════════════════════════════════════════════════════════════════\n")
cat("12. Complete-graph topology (small subset)\n")
cat("═══════════════════════════════════════════════════════════════════\n")
GDP_small <- GDP_change[1:6]
ct <- complete_topology(GDP_small, verify_axioms = TRUE)
stopifnot(
is.list(ct),
is.logical(ct$connected),
ct$n_open_sets >= 2L
)
cat("  n (subset):  ", length(GDP_small), "\n")
cat("  Open sets:   ", ct$n_open_sets, "\n")
cat("  Connected:   ", ct$connected, "\n")
if (isTRUE(ct$complete) && !is.null(ct$axioms_ok)) {
cat("  Axioms OK:   ", ct$axioms_ok, "\n")
}
cat("\n")
###############################################################################
# PART IV — INPUT VALIDATION
###############################################################################
cat("═══════════════════════════════════════════════════════════════════\n")
cat("13. Input validation\n")
cat("═══════════════════════════════════════════════════════════════════\n")
validation_tests <- list(
list(fn = "horizontal_visibility_graph",
call = function() horizontal_visibility_graph("text"), expect = "numeric"),
list(fn = "horizontal_visibility_graph",
call = function() horizontal_visibility_graph(c(1, NA)), expect = "NA"),
list(fn = "horizontal_visibility_graph",
call = function() horizontal_visibility_graph(c(1, Inf)), expect = "Inf"),
list(fn = "natural_visibility_graph",
call = function() natural_visibility_graph(c(NA, 2)), expect = "NA"),
list(fn = "generate_topology",
call = function() generate_topology("bad", 3L), expect = "list"),
list(fn = "calculate_topology",
call = function() calculate_topology(1:5, -1), expect = "non-negative"),
list(fn = "calculate_thresholds",
call = function() calculate_thresholds("text"), expect = "numeric"),
list(fn = "analyze_topology_factors",
call = function() analyze_topology_factors(c(1, NA)), expect = "NA"),
list(fn = "simplest_topology",
call = function() simplest_topology("text"), expect = "numeric"),
list(fn = "complete_topology",
call = function() complete_topology(1), expect = "at least 2")
)
passed <- 0L
for (vt in validation_tests) {
err <- tryCatch({ vt$call(); NULL }, error = function(e) e$message)
if (is.null(err)) {
cat("  FAIL:", vt$fn, "did not raise error\n")
} else if (!grepl(vt$expect, err, fixed = TRUE)) {
cat("  FAIL:", vt$fn, "error does not mention '", vt$expect, "':",
err, "\n")
} else {
passed <- passed + 1L
}
}
cat("  Validation tests:", passed, "/", length(validation_tests), "passed\n\n")
stopifnot(passed == length(validation_tests))
###############################################################################
# SUMMARY
###############################################################################
cat("═══════════════════════════════════════════════════════════════════\n")
cat("SUMMARY\n")
cat("═══════════════════════════════════════════════════════════════════\n")
cat("GDP_change: ", n, " observations\n\n")
cat("Graph-theoretic path (Nada et al.):\n")
cat("  HVG: ", hvg$n_edges, " edges | base = ", length(topo_hvg$base),
" | connected = ", topo_hvg$connected,
" | components = ", length(topo_hvg$components), "\n")
cat("  NVG: ", nvg$n_edges, " edges | base = ", length(topo_nvg$base),
" | connected = ", topo_nvg$connected,
" | components = ", length(topo_nvg$components), "\n")
if (isTRUE(topo_hvg$complete)) {
cat("  HVG topology fully enumerated: |tau| =", topo_hvg$n_open_sets, "\n")
}
if (isTRUE(topo_nvg$complete)) {
cat("  NVG topology fully enumerated: |tau| =", topo_nvg$n_open_sets, "\n")
}
cat("\n")
cat("Threshold-based path (metric approximation):\n")
for (i in seq_len(nrow(viz))) {
cat(sprintf("  %-12s  base size = %d\n", viz$method[i], viz$base_size[i]))
}
cat("\nAll validation tests passed.\n")
cat("═══════════════════════════════════════════════════════════════════\n")
View(DATOS)
lenght(DATOS$Real.GDP.Change)
length(DATOS$Real.GDP.Change)
setwd("C:/Users/ROG/Pictures/LIBRARY/topologyR")
devtools::document()
devtools::check(cran = TRUE)
devtools::build()
